{
  "$meta": {
    "version": "0.1.0",
    "source": "GitHub issue #10 (Phase 2) incl. 'Approved refinements — 2026-10-14'",
    "note": "Colours and font families are approved values from issue #10. Entries under 'provisional' are technical defaults derived from the existing site CSS and still need design approval."
  },
  "color": {
    "navy": "#0F172A",
    "blue": "#2563EB",
    "offWhite": "#F8FAFC",
    "white": "#FFFFFF",
    "slate": "#64748B",
    "mist": "#CBD5E1",
    "ivory": "#F8F5F0",
    "burgundy": "#762D35",
    "terracotta": "#D96532",
    "forest": "#245B43",
    "coral": "#FF7059"
  },
  "service": {
    "branding": { "label": "Branding", "accent": "burgundy" },
    "nettsider": { "label": "Nettsider", "accent": "terracotta" },
    "seo": { "label": "SEO", "accent": "forest" },
    "sosiale-medier": { "label": "Sosiale medier", "accent": "coral" }
  },
  "font": {
    "heading": "'Manrope Variable', Manrope, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
    "body": "'Inter Variable', Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
  },
  "provisional": {
    "typeScale": {
      "display": "clamp(2.75rem, 1.6rem + 5.2vw, 7rem)",
      "h1": "clamp(2.5rem, 1.6rem + 4vw, 5.25rem)",
      "h2": "clamp(2rem, 1.4rem + 2.8vw, 4rem)",
      "h3": "clamp(1.25rem, 1.1rem + 0.6vw, 1.75rem)",
      "lead": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)",
      "body": "1rem",
      "small": "0.875rem",
      "caption": "0.75rem"
    },
    "lineHeight": { "tight": "1.05", "snug": "1.25", "body": "1.65" },
    "space": {
      "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem",
      "6": "2rem", "7": "3rem", "8": "4rem", "9": "6rem", "10": "8rem"
    },
    "gutter": "clamp(1rem, 5vw, 8vw)",
    "maxWidth": { "text": "42rem", "content": "80rem" },
    "radius": { "sm": "4px", "md": "8px", "lg": "16px", "pill": "999px" },
    "motion": {
      "durationFast": "150ms",
      "durationBase": "200ms",
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "focus": { "width": "3px", "offset": "3px", "color": "blue", "colorOnDark": "white" }
  }
}
